# Sanity（公开数据集，构建时内联；这两项代码里有默认值，可不配）
NEXT_PUBLIC_SANITY_PROJECT_ID=dcflbleb
NEXT_PUBLIC_SANITY_DATASET=production

# Giscus 评论（四项必填，去 https://giscus.app 按仓库生成后填入）
# 1. GitHub 仓库 Settings → General → Features 开启 Discussions
# 2. https://github.com/apps/giscus 把 App 安装到该仓库
# 3. 在 giscus.app 选好仓库与分类，复制 repo_id / category_id 到这里
NEXT_PUBLIC_GISCUS_REPO=d1752472377/Akasha
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# 按需更新（Sanity webhook -> /api/revalidate）的鉴权密钥
# 部署平台配同一个值；webhook 用 ?secret= 或请求头 x-webhook-secret 携带
REVALIDATE_SECRET=change-me
